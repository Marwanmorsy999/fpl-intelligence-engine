"""Walk-forward validation for time-based evaluation.

Implements time-based evaluation that does NOT random-split historical data.

Walk-forward evaluation:
    1. Train/fit on data through Gameweek N.
    2. Predict Gameweek N+1.
    3. Expand training/history.
    4. Predict Gameweek N+2.
    5. Continue forward.

The exact mechanism is simple at this stage, but it is temporally correct.
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field
from datetime import datetime
from typing import Any

from sqlalchemy.orm import Session

from fpl_intelligence.backtesting.cutoff import (
    DecisionCutoff,
    get_gameweek_decision_cutoff,
)
from fpl_intelligence.backtesting.engine import BacktestEngine
from fpl_intelligence.backtesting.models import BacktestConfig
from fpl_intelligence.features.temporal import InformationAccessPolicy
from fpl_intelligence.prediction.base import PlayerPredictionModel

logger = logging.getLogger(__name__)


@dataclass
class WalkForwardResult:
    """Result of a walk-forward validation run."""
    season: str
    start_gameweek: int
    end_gameweek: int
    gameweek_results: list[dict[str, Any]] = field(default_factory=list)
    overall_metrics: dict[str, Any] = field(default_factory=dict)


class WalkForwardValidator:
    """Walk-forward validation for time-based model evaluation."""

    def __init__(
        self,
        db_session: Session,
        feature_registry: Any,
        prediction_model: PlayerPredictionModel,
    ) -> None:
        self._db = db_session
        self._features = feature_registry
        self._model = prediction_model
        self._engine = BacktestEngine(db_session, feature_registry, prediction_model)

    def validate(
        self,
        season: str,
        start_gameweek: int,
        end_gameweek: int,
        train_gameweeks: int = 10,
        policy: InformationAccessPolicy = InformationAccessPolicy.STRICT_REPRODUCIBILITY,
    ) -> WalkForwardResult:
        """Run walk-forward validation."""
        result = WalkForwardResult(
            season=season,
            start_gameweek=start_gameweek,
            end_gameweek=end_gameweek,
        )

        for gw in range(start_gameweek, end_gameweek + 1):
            try:
                cutoff = get_gameweek_decision_cutoff(
                    season, gw, self._db, policy
                )

                config = BacktestConfig(
                    season=season,
                    start_gameweek=gw,
                    end_gameweek=gw,
                    decision_timing="deadline",
                    information_access_policy=policy.value,
                    feature_version="1.0.0",
                    model_version=getattr(self._model, "model_version", "1.0.0"),
                    random_seed=42,
                    simulation_count=1,
                )

                run = self._engine.run(config)
                results = self._engine.get_results(run.run_id)

                for r in results:
                    result.gameweek_results.append(
                        {
                            "gameweek": gw,
                            "cutoff": cutoff.cutoff_timestamp.isoformat(),
                            "predictions": r.predictions or [],
                            "actual_outcomes": r.actual_outcomes or [],
                            "evaluation_metrics": r.evaluation_metrics or {},
                        }
                    )

                logger.info("Walk-forward GW %d completed", gw)

            except ValueError as e:
                logger.warning("Skipping gameweek %d: %s", gw, e)
                continue

        from fpl_intelligence.backtesting.evaluation import BacktestEvaluator

        evaluator = BacktestEvaluator()
        all_preds: list[dict[str, Any]] = []
        all_actuals: list[dict[str, Any]] = []

        for gw_result in result.gameweek_results:
            all_preds.extend(gw_result.get("predictions", []))
            all_actuals.extend(gw_result.get("actual_outcomes", []))

        result.overall_metrics = evaluator.evaluate_all(all_preds, all_actuals)

        return result

    def validate_with_expanding_window(
        self,
        season: str,
        start_gameweek: int,
        end_gameweek: int,
        initial_train_gameweeks: int = 6,
        policy: InformationAccessPolicy = InformationAccessPolicy.STRICT_REPRODUCIBILITY,
    ) -> WalkForwardResult:
        """Run walk-forward validation with an expanding training window."""
        if start_gameweek <= initial_train_gameweeks:
            raise ValueError(
                f"start_gameweek ({start_gameweek}) must be greater than "
                f"initial_train_gameweeks ({initial_train_gameweeks})"
            )

        return self.validate(
            season=season,
            start_gameweek=start_gameweek,
            end_gameweek=end_gameweek,
            train_gameweeks=initial_train_gameweeks,
            policy=policy,
        )