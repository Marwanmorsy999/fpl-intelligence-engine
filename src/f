"""Backtest reporting.

Generates machine-readable (JSON) and human-readable (text) reports
for backtest runs.

Report includes:
    - season
    - gameweeks
    - per-model metrics
    - data completeness
    - number of predictions
    - missing predictions
    - invalid predictions
    - feature leakage test status
"""

from __future__ import annotations

import json
from dataclasses import dataclass, field
from typing import Any

from sqlalchemy import select
from sqlalchemy.orm import Session

from fpl_intelligence.backtesting.evaluation import BacktestEvaluator
from fpl_intelligence.backtesting.models import (
    BacktestConfig,
    BacktestGameweekResult,
    BacktestRun,
    PlayerPrediction,
)
from fpl_intelligence.backtesting.reproducibility import BacktestReproducer


@dataclass
class BacktestReport:
    """A backtest report.

    Attributes:
        run_id: The backtest run ID.
        season: Season code.
        start_gameweek: First gameweek.
        end_gameweek: Last gameweek.
        model_name: Name of the model used.
        model_version: Version of the model.
        feature_version: Version of features used.
        metrics: Evaluation metrics by gameweek.
        overall_metrics: Overall evaluation metrics.
        data_completeness: Average data completeness.
        n_predictions: Total number of predictions.
        n_missing_predictions: Number of missing predictions.
        n_invalid_predictions: Number of invalid predictions.
        leakage_test_status: Status of leakage tests.
        reproducibility: Reproducibility information.
    """
    run_id: str
    season: str
    start_gameweek: int
    end_gameweek: int
    model_name: str = ""
    model_version: str = ""
    feature_version: str = ""
    metrics: dict[str, dict[str, Any]] = field(default_factory=dict)
    overall_metrics: dict[str, Any] = field(default_factory=dict)
    data_completeness: float = 0.0
    n_predictions: int = 0
    n_missing_predictions: int = 0
    n_invalid_predictions: int = 0
    leakage_test_status: str = "not_run"
    reproducibility: dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> dict[str, Any]:
        """Convert to a dictionary for JSON serialization."""
        return {
            "run_id": self.run_id,
            "season": self.season,
            "start_gameweek": self.start_gameweek,
            "end_gameweek": self.end_gameweek,
            "model_name": self.model_name,
            "model_version": self.model_version,
            "feature_version": self.feature_version,
            "metrics": self.metrics,
            "overall_metrics": self.overall_metrics,
            "data_completeness": self.data_completeness,
            "n_predictions": self.n_predictions,
            "n_missing_predictions": self.n_missing_predictions,
            "n_invalid_predictions": self.n_invalid_predictions,
            "leakage_test_status": self.leakage_test_status,
            "reproducibility": self.reproducibility,
        }

    def to_json(self) -> str:
        """Convert to JSON string."""
        return json.dumps(self.to_dict(), indent=2, default=str)

    def to_text(self) -> str:
        """Convert to human-readable text report."""
        lines = [
            f"Backtest Report: {self.run_id}",
            f"  Season: {self.season}",
            f"  Gameweeks: {self.start_gameweek}-{self.end_gameweek}",
            f"  Model: {self.model_name} v{self.model_version}",
            f"  Feature version: {self.feature_version}",
            "",
            "Overall Metrics:",
        ]

        for k, v in self.overall_metrics.items():
            lines.append(f"  {k}: {v}")

        lines.append("")
        lines.append(f"Data completeness: {self.data_completeness:.2%}")
        lines.append(f"Total predictions: {self.n_predictions}")
        lines.append(f"Missing predictions: {self.n_missing_predictions}")
        lines.append(f"Invalid predictions: {self.n_invalid_predictions}")
        lines.append(f"Leakage test status: {self.leakage_test_status}")

        if self.reproducibility:
            lines.append("")
            lines.append("Reproducibility:")
            for k, v in self.reproducibility.items():
                lines.append(f"  {k}: {v}")

        if self.metrics:
            lines.append("")
            lines.append("Per-Gameweek Metrics:")
            for gw, metrics in self.metrics.items():
                lines.append(f"  GW{gw}:")
                for k, v in metrics.items():
                    lines.append(f"    {k}: {v}")

        return "\n".join(lines)


def generate_report(
    run_id: str,
    db: Session,
    format: str = "text",
) -> BacktestReport | str:
    """Generate a backtest report.

    Args:
        run_id: The UUID of the backtest run.
        db: Database session.
        format: "text" for human-readable, "json" for machine-readable.

    Returns:
        BacktestReport object (if format="report") or string (if format="text"/"json").
    """
    run = db.scalar(select(BacktestRun).where(BacktestRun.run_id == run_id))
    if run is None:
        raise ValueError(f"BacktestRun {run_id} not found")

    config = db.get(BacktestConfig, run.config_id)
    if config is None:
        raise ValueError("BacktestConfig not found")

    # Get gameweek results
    results = list(
        db.execute(
            select(BacktestGameweekResult)
            .where(BacktestGameweekResult.run_id == run.id)
            .order_by(BacktestGameweekResult.gameweek)
        ).scalars().all()
    )

    # Get predictions
    predictions = list(
        db.execute(
            select(PlayerPrediction)
            .where(PlayerPrediction.run_id == run.id)
        ).scalars().all()
    )

    # Build report
    report = BacktestReport(
        run_id=run_id,
        season=config.season,
        start_gameweek=config.start_gameweek,
        end_gameweek=config.end_gameweek,
        model_version=run.model_version,
        feature_version=run.feature_version,
    )

    # Calculate metrics
    evaluator = BacktestEvaluator()

    all_preds: list[dict[str, Any]] = []
    all_actuals: list[dict[str, Any]] = []

    for r in results:
        gw_str = str(r.gameweek)
        preds = r.predictions or []
        actuals = r.actual_outcomes or []

        gw_metrics = evaluator.evaluate_all(preds, actuals)
        report.metrics[gw_str] = gw_metrics

        all_preds.extend(preds)
        all_actuals.extend(actuals)

    report.overall_metrics = evaluator.evaluate_all(all_preds, all_actuals)

    # Data completeness
    if predictions:
        completeness_values = [p.data_completeness or 0.0 for p in predictions]
        report.data_completeness = sum(completeness_values) / len(completeness_values)
        report.n_predictions = len(predictions)
        report.n_missing_predictions = sum(1 for p in predictions if p.data_completeness == 0)
        report.n_invalid_predictions = sum(1 for p in predictions if p.predicted_expected_points is None)

    # Reproducibility
    reproducer = BacktestReproducer(db)
    repro_result = reproducer.reproduce(run_id)
    report.reproducibility = {
        "can_reproduce": repro_result.can_reproduce,
        "data_changed": repro_result.data_changed,
        "warnings": repro_result.warnings,
    }

    if format == "text":
        return report.to_text()
    elif format == "json":
        return report.to_json()
    else:
        return report


def print_report(report: BacktestReport | str) -> None:
    """Print a backtest report to console.

    Args:
        report: Either a BacktestReport object or a string.
    """
    if isinstance(report, str):
        print(report)
    else:
        print(report.to_text())