# Phase 9.8 — Production environment variables (documentation / template).
#
# Copy to your secret store (or a git-ignored .env) and populate. Nothing here
# is committed to the repository. Every variable maps to a ProductionConfig
# field via ENV_FIELD_MAP in src/fpl_intelligence/deployment/config.py.

# --- core -------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://fpl:p@ssw0rd@prod-db:5432/fpl
FPL_BASE_URL=https://fantasy.premierleague.com
REQUEST_TIMEOUT_SECONDS=20

