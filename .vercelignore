# Files never uploaded to Vercel. Keeps the Python function bundle under the
# platform size limit (see functions.excludeFiles in vercel.json).
tests/
# Exclude the heavy data dirs from the upload, but ALLOW data/seed so the
# committed offline FPL bootstrap snapshot reaches the function bundle (it is
# consumed by POST /api/v1/admin/initialize-data and the seed-from-file path).
data/cache/
data/raw/
data/processed/
docs/
audit/
supabase/
# scripts/: heavy QA tooling stays out of the bundle, EXCEPT the deploy-time
# migration runner (v2.7.4-prod-heal) which buildCommand executes explicitly.
scripts/*
!scripts/deploy_migrate.py
.venv/
venv/
.kilo/
.mypy_cache/
.pytest_cache/
.ruff_cache/
**/__pycache__/
*.pyc
*.log
