{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ]; then exit 0; fi; exit 1",
  "buildCommand": "bash vercel_build.sh",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@6.58.0",
      "includeFiles": "{src/**,migrations/**,config/**,data/seed/**,data/set_piece_takers.json,alembic.ini,pyproject.toml,requirements.txt}",
      "excludeFiles": "{data/cache/**,data/raw/**,data/processed/**,tests/**,docs/**,audit/**,supabase/**,scripts/**,.github/**,.kilo/**,.mypy_cache/**,.pytest_cache/**,.ruff_cache/**,**/__pycache__/**}",
      "regions": ["cdg1"],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/admin/daily",
      "schedule": "10 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/telegram/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/v1/admin/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
