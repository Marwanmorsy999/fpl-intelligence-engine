{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pip install .",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@6.58.0",
      "includeFiles": "{src/**,migrations/**,config/**,data/seed/**,alembic.ini,pyproject.toml,requirements.txt}",
      "excludeFiles": "{data/cache/**,data/raw/**,data/processed/**,tests/**,docs/**,audit/**,supabase/**,scripts/**,.github/**,.kilo/**,.mypy_cache/**,.pytest_cache/**,.ruff_cache/**,**/__pycache__/**}",
      "regions": ["cdg1"],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/admin/ingest-fpl",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/admin/materialize",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/v1/admin/run-scheduler",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/v1/admin/friday-brief",
      "schedule": "0 18 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/telegram/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/v1/admin/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
