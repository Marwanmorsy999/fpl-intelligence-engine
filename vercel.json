{
  "version": 2,
  "buildCommand": "pip install .",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@6.57.1",
      "excludeFiles": "{data,tests}/**",
      "regions": ["cdg1"],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/admin/ingest-fpl",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/admin/run-scheduler",
      "schedule": "30 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/telegram/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/v1/admin/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
