# Phase 11.2 — Production environment variables template.
#
# Copy to `.env` (git-ignored) and populate. NEVER commit real secrets.
# Used by docker-compose.prod.yml, the Procfile, and settings.py.

# --- core -------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl
APP_ENV=production
LOG_LEVEL=INFO
FPL_BASE_URL=https://fantasy.premierleague.com
REQUEST_TIMEOUT_SECONDS=20

# --- Phase 18.0 FPL egress mask chain ----------------------------------------
# When the direct FPL fetch is blocked (403/429/500 on shared egress), the
# importer tries, in order: direct -> allorigins -> corsproxy.io -> THIS URL.
# Set FPL_PROXY_URL to your Google Apps Script proxy base (the engine appends
# ?url=<encoded fpl url> itself). Leave empty to skip the last mask.
FPL_PROXY_URL=
EGRESS_STRATEGY_TIMEOUT=4
EGRESS_CACHE_TTL=60

# --- Phase 19.0 real-system sync trio ----------------------------------------
# Shared secret for machine-to-machine pushes (bookmarklet, Apps Script,
# GitHub Actions). Push endpoints require: Authorization: Bearer <token>.
# Empty = pushes disabled (endpoints answer 503). Paste the same value into
# the GitHub Actions SYNC_PUSH_TOKEN secret and your Apps Script TOKEN.
SYNC_PUSH_TOKEN=

# GitHub Actions data refresh target (repo secret ENGINE_BASE), e.g.
# https://your-app.vercel.app — used by .github/workflows/data-refresh.yml

# --- data provider API keys (optional; system degrades gracefully) ----------
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
THE_ODDS_API_KEY=

# --- Telegram bot (Phase 10.2) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Phase 23 self-hosted web push (L2) ---------------------------------------
# Generate ONCE with: python scripts/generate_vapid_keys.py
# Without these the in-app bell still works; browser push stays disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional AI Analyst LLM providers (Phase 9.3) --------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Safety: default false so the engine never makes live LLM calls unless opted in.
FPL_API_USE_LIVE_LLM=false

# --- Frontend separation / CORS (Vercel readiness) --------------------------
# When false, FastAPI serves only the JSON API (static SPA hosted elsewhere).
SERVE_STATIC_DASHBOARD=true
# Comma-separated list of allowed CORS origins, e.g. https://fpl.example.vercel.app
CORS_ORIGINS=

# --- Scheduler worker (Phase 9.6) -------------------------------------------
RSS_FEED_URL=
SCHEDULER_INTERVAL_SECONDS=900
SCHEDULER_MIN_INTERVAL=30

# --- Postgres provisioning (consumed by docker-compose) ---------------------
POSTGRES_DB=fpl
POSTGRES_USER=fpl
POSTGRES_PASSWORD=

# --- Phase 9.8 monitoring / notifications (optional) ------------------------
SENTRY_DSN=
# SLACK_WEBHOOK_URL=
# CRITICAL_ERROR_WEBHOOK_URL=
