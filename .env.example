# Phase 11.2 — Production environment variables template.
#
# Copy to `.env` (git-ignored) and populate. NEVER commit real secrets.
# Used by docker-compose.prod.yml, the Procfile, and settings.py.

# --- core -------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl
APP_ENV=production
LOG_LEVEL=INFO
FPL_BASE_URL=https://fantasy.premierleague.com
REQUEST_TIMEOUT_SECONDS=20

# --- data provider API keys (optional; system degrades gracefully) ----------
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=

# --- Telegram bot (Phase 10.2) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Optional AI Analyst LLM providers (Phase 9.3) --------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Safety: default false so the engine never makes live LLM calls unless opted in.
FPL_API_USE_LIVE_LLM=false

# --- Frontend separation / CORS (Vercel readiness) --------------------------
# When false, FastAPI serves only the JSON API (static SPA hosted elsewhere).
SERVE_STATIC_DASHBOARD=true
# Comma-separated list of allowed CORS origins, e.g. https://fpl.example.vercel.app
CORS_ORIGINS=

# --- Scheduler worker (Phase 9.6) -------------------------------------------
RSS_FEED_URL=
SCHEDULER_INTERVAL_SECONDS=900
SCHEDULER_MIN_INTERVAL=30

# --- Postgres provisioning (consumed by docker-compose) ---------------------
POSTGRES_DB=fpl
POSTGRES_USER=fpl
POSTGRES_PASSWORD=

# --- Phase 9.8 monitoring / notifications (optional) ------------------------
# SLACK_WEBHOOK_URL=
# CRITICAL_ERROR_WEBHOOK_URL=
